# Cloudflare Pages - Configuración de Headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Headers globales para todas las páginas
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()

# HTML - Cache corto para páginas principales
/*.html
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400

# Archivos estáticos - Cache largo
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/img/*
  Cache-Control: public, max-age=31536000, immutable

# Archivos JSON de datos - Cache medio con revalidación
/data/*.json
  Cache-Control: public, max-age=3600, s-maxage=7200, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8

/data/*.json.br
  Cache-Control: public, max-age=3600, s-maxage=7200
  Content-Encoding: br
  Content-Type: application/json; charset=utf-8

/data/*.json.gz
  Cache-Control: public, max-age=3600, s-maxage=7200
  Content-Encoding: gzip
  Content-Type: application/json; charset=utf-8

# Archivos comprimidos
*.br
  Content-Encoding: br

*.gz
  Content-Encoding: gzip

# Imágenes optimizadas
*.webp
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

*.jpg
  Cache-Control: public, max-age=31536000, immutable

*.jpeg
  Cache-Control: public, max-age=31536000, immutable

*.png
  Cache-Control: public, max-age=31536000, immutable

# Documentos
*.pdf
  Cache-Control: public, max-age=86400
  Content-Type: application/pdf

# Manifests y configuración
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

# Página principal - Cache corto
/index.html
  Cache-Control: public, max-age=1800, s-maxage=3600, stale-while-revalidate=86400
  Link: </css/index.css>; rel=preload; as=style
  Link: </js/index.js>; rel=preload; as=script
  Link: </fonts/bebas-neue-400-latin.woff2>; rel=preload; as=font; type=font/woff2; crossorigin
